# Environment variables template — copy to .env

# IBM Watsonx AI
IBM_WATSON_URL=https://us-south.ml.cloud.ibm.com
IBM_API_KEY=your-ibm-api-key-here
IBM_PROJECT_ID=ee9ca177-dd2a-4be0-96e3-bf2a45b494fe
IBM_GRANITE_MODEL=ibm/granite-8b-code-instruct

# Database
DATABASE_URL=postgresql://cyclone_user:cyclone_pass@localhost:5432/cycloneshield_db
REDIS_URL=redis://localhost:6379/0

# Weather APIs
OPENWEATHER_API_KEY=your-openweather-api-key
IMD_API_KEY=your-imd-api-key

# Security
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production

# App
ENVIRONMENT=development
DEBUG=true
